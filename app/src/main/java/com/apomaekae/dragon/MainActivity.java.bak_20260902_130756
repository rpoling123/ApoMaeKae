    private void updateLastPageKeyBox() {

        if (lastPageKeyView == null) return;

        try {

            String key = LicenseClient.getKey(this);
            String exp = LicenseClient.getExpires(this);

            if (key == null || key.trim().isEmpty()) {
                lastPageKeyView.setText("🔑 KEY: ยังไม่มี");
                lastPageKeyView.setTextColor(Color.rgb(180,80,0));
                return;
            }

            if (exp == null || exp.trim().isEmpty()) {
                lastPageKeyView.setText(
                    "🔑 " + key +
                    "\n🟡 ยังไม่มีวันหมดอายุ"
                );
                return;
            }

            Date expiry = parseDate(exp);
            long left = expiry.getTime() - System.currentTimeMillis();

            Calendar c = Calendar.getInstance();
            c.setTime(expiry);

            String expiryText = String.format(
                Locale.getDefault(),
                "%02d/%02d/%04d %02d:%02d",
                c.get(Calendar.DAY_OF_MONTH),
                c.get(Calendar.MONTH)+1,
                c.get(Calendar.YEAR)+543,
                c.get(Calendar.HOUR_OF_DAY),
                c.get(Calendar.MINUTE)
            );

            if (left <= 0) {

                lastPageKeyView.setText(
                    "🔴 KEY หมดอายุ" +
                    "\n🔑 " + key +
                    "\n📅 " + expiryText
                );

                lastPageKeyView.setTextColor(Color.rgb(190,0,0));
                return;
            }

            long total = left / 1000;

            long days = total / 86400;
            total %= 86400;

            long hours = total / 3600;
            total %= 3600;

            long minutes = total / 60;
            long seconds = total % 60;

            lastPageKeyView.setText(
                "🟢 KEY ใช้งานอยู่" +
                "\n🔑 " + key +
                "\n📅 หมดอายุ " + expiryText +
                "\n⏳ " +
                days + "วัน " +
                hours + "ชม. " +
                minutes + "น. " +
                seconds + "วิ."
            );

            lastPageKeyView.setTextColor(Color.rgb(0,105,55));

        } catch(Exception e) {

            lastPageKeyView.setText(
                "🔑 KEY" +
                "\n📅 หมดอายุ: ตรวจสอบ..."
            );
        }
    }

